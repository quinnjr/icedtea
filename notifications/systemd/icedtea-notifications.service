[Unit]
Description=icedtea notification daemon
Documentation=https://github.com/quinnjr/icedtea-wm
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/icedtea-notifications
# on-failure (not always): a bus-name conflict with an already-running
# mako/dunst makes the daemon exit *cleanly* (code 0) rather than crash, so
# on-failure deliberately does not respawn it into a crash-loop. A genuine
# fault (exit 1) is still retried.
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
