[Unit]
Description=icedtea session: publish WAYLAND_DISPLAY
Documentation=https://github.com/quinnjr/icedtea
After=icedtea-compositor.service
# Follow the compositor's lifetime: if the compositor restarts and picks a
# different socket name, this publisher stops and re-publishes rather than
# leaving a stale WAYLAND_DISPLAY in the user manager.
BindsTo=icedtea-compositor.service
Before=icedtea-clipboard.service icedtea-session.service icedtea-shell.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=RUST_LOG=info
ExecStart=/usr/bin/env icedtea-wait wayland-env
